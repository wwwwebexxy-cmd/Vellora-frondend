# Local development uses the local backend process through Vite's /backend proxy.
# Add the new project's production API origin only in the new deployment setup.
VITE_VELLORA_API_BASE_URL=/backend
VITE_VELLORA_DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Public OAuth client ID only. Never put a client secret in VITE_* variables.
VITE_VELLORA_GOOGLE_CLIENT_ID=

# Cashfree hosted checkout uses only a public browser mode.
VITE_VELLORA_CASHFREE_MODE=sandbox
